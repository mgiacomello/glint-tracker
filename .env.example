# ── Google OAuth ──────────────────────────────────────────────────────────────
# Crea le credenziali su: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URL callback — deve corrispondere esattamente a quello configurato in Google Console
# Local:      http://localhost:3000/auth/google/callback
# Render:     https://glint-tracker.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Sicurezza sessioni ────────────────────────────────────────────────────────
SESSION_SECRET=cambia-questo-con-una-stringa-random-lunga

# ── Token per scheduled task (briefing mattutino) ────────────────────────────
SYSTEM_TOKEN=cambia-questo-token

# ── Anthropic (AI chat + analyze-recap) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
